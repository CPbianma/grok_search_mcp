# Copy this file to .env and fill in the values.
# Do NOT commit .env to git.

# Required: API key configured in your grok2api deployment (app.api_key).
GROK_API_KEY=

# Base URL of your grok2api deployment (OpenAI-compatible endpoint).
# Default points to a local grok2api instance: http://localhost:8000/v1
GROK_BASE_URL=http://localhost:8000/v1

# Model id to use for chat completions. See grok2api README for the full list.
GROK_MODEL=grok-4.20-fast

# Request timeout in milliseconds.
GROK_TIMEOUT_MS=90000

# Optional: HTTP(S) proxy used by Node's fetch. Leave empty if not needed.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NODE_USE_ENV_PROXY=1
