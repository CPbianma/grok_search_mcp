# Copy this file to .env and fill in the values.
# Do NOT commit .env to git.

# Required: API key configured in your grok2api deployment (app.api_key).
GROK_API_KEY=

# Base URL of your grok2api deployment (OpenAI-compatible endpoint).
# Default points to a local grok2api instance: http://localhost:8000/v1
GROK_BASE_URL=http://localhost:8000/v1

# Per-request idle timeout (ms) for fast tools: grok_search, grok_fact_check.
# This is an idle timeout: the timer resets every time we receive an SSE chunk.
GROK_TIMEOUT_MS=120000

# Per-request idle timeout (ms) for grok_deep_search. Deep multi-agent
# research is much slower, so it gets its own (longer) budget.
GROK_DEEP_TIMEOUT_MS=300000

# Default to streaming (`stream: true`) so long-running web searches keep the
# connection warm and we never wait on a single huge response. Set to `false`
# to fall back to a regular non-streaming POST for debugging.
GROK_STREAM=true

# NOTE: Models are pinned in the server and are NOT configurable via env:
#   grok_search       -> grok-4.3
#   grok_deep_search  -> grok-4.20-multi-agent
#   grok_fact_check   -> grok-4.3
# Do not set GROK_MODEL — it is intentionally ignored.

# Optional: HTTP(S) proxy used by Node's fetch. Leave empty if not needed.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NODE_USE_ENV_PROXY=1
